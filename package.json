{
  "name": "kuesioner-nomophobia-cf",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/app.css -o ./public/app.css --minify",
    "dev": "npm run build:css && wrangler dev",
    "deploy": "npm run build:css && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute nomophobia-db --local --file=./migrations/0001_create_submissions.sql",
    "db:migrate:remote": "wrangler d1 execute nomophobia-db --remote --file=./migrations/0001_create_submissions.sql"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "alpinejs": "^3.15.12",
    "xlsx": "^0.18.5"
  }
}
